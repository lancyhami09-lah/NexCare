# NexCare Configuration Environment Variables

# Choose Data Mode: 'mock' (default, zero-config in-memory) or 'mysql'
DATA_MODE=mock

# Application Secret Key
SECRET_KEY=nexcare-local-demo-secret-key-change-me

# MySQL Database Configuration (Required only if DATA_MODE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=nexcare
